{
  "name": "amari-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Amari \u2014 AI kitchen assistant landing page.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build:check && npm run lint && node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build:check && wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "playwright": "1.63.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
